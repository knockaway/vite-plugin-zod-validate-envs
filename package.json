{
  "name": "@knockaway/vite-plugin-zod-validate-envs",
  "version": "1.0.0",
  "description": "Vite plugin to validate and transform environment variables using Zod",
  "keywords": [
    "vite",
    "vite-plugin",
    "env-var",
    "validation",
    "zod",
    "env"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "unbuild",
    "build": "unbuild",
    "format": "prettier --single-quote --write ."
  },
  "dependencies": {
    "unconfig": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vite": "^7 || ^8",
    "zod": "^4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
